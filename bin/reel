#!/bin/bash
# Runs the reel CLI from this checkout, also when called through a symlink (skill/reel): bin/reel --help
root=$(python3 -c 'import os, sys; print(os.path.dirname(os.path.dirname(os.path.realpath(sys.argv[1]))))' "$0")
# -u: progress lines show up as they happen, also when output goes to a file or a pipe.
PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec python3 -u -m reel.cli "$@"
